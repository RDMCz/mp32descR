<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="mp32descR.View.MainWindow"
        Title="mp32descR"
        MinWidth="1309"
        MinHeight="720"
        FontSize="16"
        Icon="/Asset/Icon/icon.ico">
    <DockPanel>

        <Menu DockPanel.Dock="Top" Background="#f2f2f2">
            <MenuItem Header="Help">
                <MenuItem Header="About"></MenuItem>
            </MenuItem>
        </Menu>

        <Grid ColumnDefinitions="370,*">
            <!-- Left part of the app with path input, file loading info, ... -->
            <Grid Margin="5" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="5">
                <!-- Path input -->
                <TextBox Name="TextBoxPath" IsReadOnly="True"></TextBox>

                <!-- Button duo -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
                    <Button Name="ButtonRevealInExplorer" Content="Reveal in explorer"
                            Click="ButtonRevealInExplorerClicked">
                    </Button>
                    <Button Name="ButtonChangeDirectory" Grid.Column="2" Content="Change directory"
                            Click="ButtonChangeFolderClicked">
                    </Button>
                </Grid>

                <!-- Loaded files info -->
                <TextBlock Grid.Row="2" Name="TextBlockFilesInfo" TextWrapping="Wrap"></TextBlock>

                <!-- Duplicate checker -->
                <GroupBox Grid.Row="3" Name="GroupBoxDuplicateChecker" Header="Duplicate checker" Padding="5">
                    <StackPanel Spacing="5">
                        <CheckBox Name="CheckBoxDuplicateCheckerBracketsIgnore"
                                  Content="Ignore the text in parentheses">
                        </CheckBox>
                        <Button Content="Check" Click="ButtonDuplicateCheckerClicked"></Button>
                    </StackPanel>
                </GroupBox>

                <!-- Loading files progress bar -->
                <ProgressBar Grid.Row="4" Name="ProgressBar" Minimum="0" Height="18" Margin="0,4,0,5"
                             Foreground="#8c42ad" Background="#ebcff8"
                             ShowProgressText="True" ProgressTextFormat="{}{0}/{3} ({1:0}%)	">
                </ProgressBar>
            </Grid>

            <!-- Right part of the app with output and its options -->
            <Grid Grid.Column="1" Margin="5" RowDefinitions="*,Auto,Auto" RowSpacing="5">
                <!-- Main output :: RESULT -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <TextBox Name="TextBoxResult" IsReadOnly="True"></TextBox>
                </ScrollViewer>

                <!-- Format input -->
                <Grid Grid.Row="1" ColumnDefinitions="*,30">
                    <TextBox Name="TextBoxTemplate"></TextBox>
                    <Button Grid.Column="1" Content="?" Click="ButtonTemplateHelperClicked">
                        <Button.ContextMenu>
                            <!-- Button's context menu options are set in code -->
                            <ContextMenu Name="ContextMenuTemplateHelper" FontSize="16"></ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>

                <!-- Options and actions -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,100,100,150" ColumnSpacing="5">
                    <CheckBox Name="CheckBoxTimestamps" Content="Prefix with YouTube timestamps"></CheckBox>

                    <CheckBox Name="CheckBoxSubdirectories" Grid.Column="1" Content="Include names of subdirectories"
                              Margin="20,0,0,0">
                    </CheckBox>

                    <Button Name="ButtonSave" Grid.Column="3" Content="Save" Click="ButtonSaveClicked"></Button>
                    <Button Name="ButtonCopy" Grid.Column="4" Content="Copy" Click="ButtonCopyClicked"></Button>
                    <Button Name="ButtonGenerate" Grid.Column="5" Content="Generate" Click="ButtonGenerateClicked"></Button>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>