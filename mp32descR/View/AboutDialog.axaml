<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="mp32descR.View.AboutDialog"
        Title="About"
        Width="380"
        Height="170"
        FontSize="16"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <Grid RowDefinitions="*,Auto" Margin="20">
        <StackPanel Spacing="8">
            <TextBlock Text="mp32descR"></TextBlock>
            <TextBlock Name="TextBlockVersion" Text="version unknown"></TextBlock>
            <HyperlinkButton NavigateUri="https://github.com/RDMCz/mp32descR"
                             Content="github.com/RDMCz/mp32descR" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="100" Click="ButtonOkClicked"></Button>
        </StackPanel>
    </Grid>

</Window>